table D_Calendario
	lineageTag: 2d14ebd5-3c1c-43f1-b1e0-6a7bd6a5cc01
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey: true
		formatString: Short Date
		lineageTag: 2d14ebd5-3c1c-43f1-b1e0-6a7bd6a5cc02
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition D_Calendario = m
		mode: import
		queryGroup: 'Tabelas Dimensão'
		source = ```
				let
				    Datas = List.Dates(#date(2025, 1, 1), 1095, #duration(1, 0, 0, 0)),
				    Tabela = Table.FromList(Datas, Splitter.SplitByNothing(), {"Date"}, null, ExtraValues.Error),
				    Tipada = Table.TransformColumnTypes(Tabela, {{"Date", type date}})
				in
				    Tipada
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

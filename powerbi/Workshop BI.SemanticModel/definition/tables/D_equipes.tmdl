table D_equipes
	lineageTag: 53e5d061-391a-4e47-84da-a0949d0b4a0e

	column EQUIPES
		dataType: string
		lineageTag: 5ec12020-39b7-4218-aa0c-718278497339
		summarizeBy: none
		sourceColumn: EQUIPES

		annotation SummarizationSetBy = Automatic

	partition D_equipes = m
		mode: import
		queryGroup: 'Tabelas Dimensão'
		source = ```
			let
			    Fonte = F_atendimentos,
			    EquipesLista = Table.Distinct(Table.SelectColumns(Fonte,{"DESC_EQUIPE"})),
			    Renomeadas = Table.RenameColumns(EquipesLista,{{"DESC_EQUIPE", "EQUIPES"}}),
			    SemNulos = Table.SelectRows(Renomeadas, each [EQUIPES] <> null)
			in
			    SemNulos
			```

model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Tabela Fato'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Tabelas Dimensão'

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["F_atendimentos","F_planejamento","F_paradas","D_equipes","D_turnos"]

annotation PBI_ProTooling = ["DevMode"]

ref table F_atendimentos
ref table D_equipes
ref table D_turnos
ref table F_planejamento
ref table F_paradas

ref cultureInfo pt-BR

ref table D_Calendario
ref table D_Motivo
